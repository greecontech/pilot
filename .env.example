# PostgreSQL connection string. On Railway use a reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greecon
# Set to "true" only if your database requires SSL and the URL does not already configure it.
DATABASE_SSL=false

# Random string, at least 32 characters (e.g. `openssl rand -base64 48`). Required in production.
SESSION_SECRET=

# First administrator — created on first start when the users table is empty.
ADMIN_EMAIL=eridon.manuka@greecon.earth
ADMIN_PASSWORD=
ADMIN_NAME=Eridon Manuka

# Demo data: 3 sites with 30 days of history, and a live simulator writing readings.
SEED_DEMO=true
SIMULATOR=true
SIMULATOR_INTERVAL_SECONDS=60

# Startup Albania project month 1 = this date's month.
PROJECT_START_DATE=2026-08-01
APP_TIMEZONE=Europe/Tirane

# Email alerts (pilot). Uses Resend's HTTPS API: Railway blocks SMTP on Free/Trial/Hobby plans.
# Leave RESEND_API_KEY empty to run without email. The sender domain must be verified in Resend.
RESEND_API_KEY=
ALERT_EMAIL_FROM="Greecon Alerts <alerts@greecon.earth>"
# Initial recipients, comma-separated. Can be changed later under Settings & audit > Alert emails.
ALERT_EMAIL_TO=
# Public address of the platform, used for the links inside emails (Railway's own domain is the fallback).
APP_URL=
# Minimum hours between emails for the same metric, and minutes of silence before "station offline".
ALERT_EMAIL_COOLDOWN_HOURS=6
OFFLINE_AFTER_MINUTES=90
